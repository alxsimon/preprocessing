BootStrap: docker
From: ubuntu:18.04

%labels
	Author Alexis Simon
	Version v0.0.1

%environment
	export PATH=/opt/conda/bin:$PATH
	export PATH=/opt/tools/bin:$PATH

%post
	DEBIAN_FRONTEND=noninteractive

	# Set French mirror for apt
	sed -i -e 's/archive/fr\.archive/' /etc/apt/sources.list

	apt-get update
	apt-get install -y --no-install-recommends \
		apt-utils \
		wget \
		gnupg \
		curl \
		bzip2 \
		software-properties-common \
		dirmngr \
		apt-transport-https \
		lsb-release \
		ca-certificates \
		tzdata

	### Install Conda ###
	echo 'export PATH=/opt/conda/bin:$PATH' > /etc/profile.d/conda.sh \
	&& curl -sSL https://repo.continuum.io/miniconda/Miniconda3-latest-Linux-x86_64.sh -o /tmp/miniconda.sh \
	&& bash /tmp/miniconda.sh -bp /opt/conda \
	&& export PATH=/opt/conda/bin:$PATH \
	&& conda update -y conda \
	&& conda clean --all --yes

	conda config --add channels defaults
	conda config --add channels bioconda
	conda config --add channels conda-forge

	## Install Bioinfo tools ##
	conda install -y \
		snakemake=5.4.4 \
		samtools=1.9 \
		bamtools=2.5.1 \
		vcftools=0.1.16 \
		fastqc=0.11.8 \
		fastp=0.19.7 \
		bwa=0.7.17 \
		gatk4=4.1.1.0 \

	## gatk3 ##
	mkdir -p /opt/tools/gatk3
	wget 'https://software.broadinstitute.org/gatk/download/auth?package=GATK-archive&version=3.8-1-0-gf15c1c3ef' \
		-O /tmp/gatk-3.8-1-0.tar.bz2
	tar -xvjf /tmp/gatk-3.8-1-0.tar.bz2 -C /tmp/
	cp /tmp/GenomeAnalysisTK-3.8-1-0-gf15c1c3ef/GenomeAnalysisTK.jar /opt/tools/gatk3/
	rm -r /tmp/gatk-3.8-1-0.tar.bz2 /tmp/GenomeAnalysisTK-3.8-1-0-gf15c1c3ef

%apprun run
	exec /bin/bash "$@"

%runscript
	exec /bin/bash "$@"
